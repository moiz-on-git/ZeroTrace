# ZeroTrace Environment Configuration Template
# Copy to .env for local development

# Environment & Server
ZT_ENV=development
ZT_DEBUG=true
ZT_PORT=8001
ZT_HOST=0.0.0.0
ZT_CORS_ORIGINS=["http://localhost:3000","http://localhost:8001","https://app.zerotrace.dev","*"]

# Secrets & Authentication
ZT_SERVICE_KEY=dev-service-key
ZT_JWT_SECRET=zerotrace-demo-jwt-secret-key-must-be-at-least-32-bytes-long
ZT_PEPPER_SECRET=zerotrace-pseudonym-hmac-pepper-secret-key-32-bytes

# Databases
ZT_DATABASE_URL=sqlite+aiosqlite:///./zerotrace_app.db
# Production: postgresql+asyncpg://postgres:ztpassword123@localhost:5432/zt_app
ZT_REDIS_URL=redis://localhost:6379/1

# Upstream Services
ZT_DATAPLANE_URL=http://localhost:8002

# AI / NLP Providers
ZT_SARVAM_API_KEY=mock-sarvam-key
ZT_SARVAM_ENDPOINT=https://api.sarvam.ai/speech-to-text
ZT_GEMMA_MODEL_ID=gemma-2-9b-it
ZT_GEMMA_API_BASE=http://localhost:11434/v1
ZT_ENABLE_OFFLINE_FALLBACK=true

# Cryptography & Proof Signing (Ed25519)
ZT_SIGNER_PRIVATE_KEY=9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60
ZT_POLICY_VERSION=dpdp-2023-v1.4

# Blockchain Anchoring
ZT_ANCHOR_PROVIDER=local
ZT_SHIPRITE_API_KEY=mock-shiprite-key
ZT_SHIPRITE_ENDPOINT=https://api.shiprite.io/v1/anchor
ZT_EVM_RPC_URL=http://localhost:8545
ZT_EVM_CONTRACT_ADDRESS=0x742d35Cc6634C0532925a3b844Bc454e4438f44e
