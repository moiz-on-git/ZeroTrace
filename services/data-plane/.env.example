# ─── ZeroTrace Data Plane — Environment Variables ───────────────────────────
# Copy to .env and fill in values. Never commit .env to git.

# ── Service ──────────────────────────────────────────────────────────────────
ZT_ENV=development                        # development | production
ZT_LOG_LEVEL=INFO
ZT_SERVICE_KEY=changeme-service-key       # shared with orchestrator
ZT_DATA_PLANE_PORT=8002

# ── Postgres ─────────────────────────────────────────────────────────────────
ZT_PG_HOST=localhost
ZT_PG_PORT=5432
ZT_PG_USER=ztuser
ZT_PG_PASSWORD=changeme
ZT_PG_DB_APP=zt_app                       # jobs, locator index, key store
ZT_PG_DB_RAG=zt_rag                       # pgvector embeddings
ZT_PG_DB_CATALOG=zt_catalog               # Iceberg JDBC catalog

# ── Redis ─────────────────────────────────────────────────────────────────────
ZT_REDIS_HOST=localhost
ZT_REDIS_PORT=6379
ZT_REDIS_CACHE_DB=0                       # company semantic cache (Moiz owns)
ZT_REDIS_QUEUE_DB=1                       # ARQ / event bus (platform-owned)

# ── Object Storage ────────────────────────────────────────────────────────────
ZT_S3_ENDPOINT=http://localhost:9000      # MinIO for dev, real S3 for prod
ZT_S3_ACCESS_KEY=minioadmin
ZT_S3_SECRET_KEY=minioadmin
ZT_S3_BUCKET=kaveri-finserv-lake
ZT_S3_REGION=ap-south-1
ZT_S3_VERSIONING_ENABLED=true

# ── Iceberg Catalog ──────────────────────────────────────────────────────────
# Options: jdbc | rest
ZT_ICEBERG_CATALOG_TYPE=jdbc
ZT_ICEBERG_CATALOG_JDBC_URI=postgresql+psycopg2://ztuser:changeme@localhost:5432/zt_catalog
ZT_ICEBERG_CATALOG_REST_URI=http://localhost:8181
ZT_ICEBERG_WAREHOUSE=s3a://kaveri-finserv-lake/warehouse

# ── Spark ────────────────────────────────────────────────────────────────────
ZT_SPARK_DRIVER_MEMORY=4g
ZT_SPARK_EXECUTOR_MEMORY=2g
ZT_SPARK_LOCAL_DIRS=/tmp/spark-local

# ── Embeddings model ─────────────────────────────────────────────────────────
ZT_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
ZT_EMBED_MODEL_PATH=/app/models/embed    # baked into Docker image

# ── LLM (optional, for RAG copilot) ──────────────────────────────────────────
ZT_LLM_PROVIDER=                          # leave blank for extractive fallback
ZT_LLM_API_KEY=
ZT_LLM_MODEL=

# ── Crypto shred ─────────────────────────────────────────────────────────────
ZT_ENABLE_CRYPTO_SHRED=false
ZT_MASTER_KEY=changeme-32-byte-master-key-here!

# ── Demo flags ───────────────────────────────────────────────────────────────
ZT_DEMO_AUTO_APPROVE=false
ZT_DEMO_GHOST_MISS=false                  # makes first audit pass miss ghost embedding

# ── Seed profiles ─────────────────────────────────────────────────────────────
ZT_SEED_PROFILE=small                     # small | showtime
ZT_SEED_RANDOM_SEED=42
