  "components": {
    "schemas": {
      "AuditRequest": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "identifiers": {
            "items": {
              "$ref": "#/components/schemas/Identifier"
            },
            "type": "array",
            "title": "Identifiers"
          },
          "attacks": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attacks"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "identifiers"
        ],
        "title": "AuditRequest"
      },
      "ExecuteRequest": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "plan_id": {
            "type": "string",
            "title": "Plan Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "both",
              "crypto_only",
              "physical_only"
            ],
            "title": "Mode",
            "default": "both"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "plan_id"
        ],
        "title": "ExecuteRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HoldSpec": {
        "properties": {
          "category": {
            "type": "string",
            "title": "Category",
            "default": ""
          },
          "table": {
            "type": "string",
            "title": "Table",
            "default": ""
          },
          "legal_basis": {
            "type": "string",
            "title": "Legal Basis"
          },
          "release_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Release Date"
          }
        },
        "type": "object",
        "required": [
          "legal_basis"
        ],
        "title": "HoldSpec"
      },
      "Identifier": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "phone",
              "email",
              "customer_id",
              "name",
              "full_name",
              "pan"
            ],
            "title": "Type"
          },
          "value": {
            "type": "string",
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "type",
          "value"
        ],
        "title": "Identifier"
      },
      "LocateRequest": {
        "properties": {
          "identifiers": {
            "items": {
              "$ref": "#/components/schemas/Identifier"
            },
            "type": "array",
            "title": "Identifiers"
          },
          "variants": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Variants"
          }
        },
        "type": "object",
        "required": [
          "identifiers"
        ],
        "title": "LocateRequest"
      },
      "ManifestRequest": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "label": {
            "type": "string",
            "enum": [
              "pre",
              "post"
            ],
            "title": "Label"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "label"
        ],
        "title": "ManifestRequest"
      },
      "PlanRequest": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "subject_ref": {
            "type": "string",
            "title": "Subject Ref"
          },
          "identifiers": {
            "items": {
              "$ref": "#/components/schemas/Identifier"
            },
            "type": "array",
            "title": "Identifiers"
          },
          "holds": {
            "items": {
              "$ref": "#/components/schemas/HoldSpec"
            },
            "type": "array",
            "title": "Holds"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "subject_ref",
          "identifiers"
        ],
        "title": "PlanRequest"
      },
      "RemediateRequest": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "residual_locations": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Residual Locations"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "residual_locations"
        ],
        "title": "RemediateRequest"
      },
      "ScenarioRequest": {
        "properties": {
          "ghost_miss": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ghost Miss"
          },
          "auto_approve": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Auto Approve"
          }
        },
        "type": "object",
        "title": "ScenarioRequest"
      },
      "SeedRequest": {
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "small",
              "showtime"
            ],
            "title": "Profile",
            "default": "small"
          }
